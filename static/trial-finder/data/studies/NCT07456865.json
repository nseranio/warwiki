{"schema":1,"id":"NCT07456865","briefTitle":"Post Approval Effectiveness and Durability Evaluation of the Altaviva™ Tibial Device","officialTitle":"Post Approval Effectiveness and Durability Evaluation of the Altaviva™ Tibial Device","acronym":"ENDURANCE™","ids":["MDT25016"],"status":{"overall":"RECRUITING","verified":"2026-11","lastUpdatePosted":{"d":"2026-11-24","t":"ACTUAL"},"firstPosted":{"d":"2026-03-09","t":"ACTUAL"},"start":{"d":"2026-03-17","t":"ACTUAL"},"primaryCompletion":{"d":"2032-11","t":"ESTIMATED"},"completion":{"d":"2032-11","t":"ESTIMATED"}},"design":{"type":"INTERVENTIONAL","phases":["NA"],"allocation":"NA","model":"SINGLE_GROUP","purpose":"TREATMENT","masking":"NONE","enrollment":{"count":256,"type":"ESTIMATED"}},"conditions":["Urge Urinary Incontinence"],"arms":[],"interventions":[{"type":"DEVICE","name":"Altaviva™ system","otherNames":[]}],"eligibility":{"text":"Inclusion Criteria:\n\n1. Candidate for Altaviva™ therapy per Altaviva™ labeling\n2. Have a diagnosis of UUI as demonstrated on a 3-day voiding diary by having a minimum of 3 episodes of urinary urge incontinence in 72 hours\n3. If taking OAB medications, subjects should be on a stable dose for at least 3 months prior to baseline and willing to remain on stable treatment through completion of the 12-month voiding diary\n4. Patient must be willing and able to accurately complete study questionnaires, attend visits, operate the system, and comply with the study protocol\n5. Willing and able to provide signed and dated informed consent\n\nExclusion Criteria:\n\n1. Patient who is not a candidate for Altaviva™ therapy per Altaviva™ labeling, including:\n\n   * Patients who are considered to be poor surgical candidates or who are at risk for poor wound healing per Altaviva™ labeling\n   * Have progressive, systemic neurological disease\n   * Have clinically significant peripheral neuropathy in the lower leg\n   * Severe, uncontrolled diabetes\n2. Have primary stress incontinence or mixed incontinence where the stress component overrides the urge component based on physician judgment\n3. Current symptomatic urinary tract infection\n4. Patients who have been treated with percutaneous tibial nerve stimulation (PTNS)/percutaneous tibial neuromodulation (PTNM) therapy in the past 4 weeks, or longer if the investigator judges that the therapeutic effect is still present\n5. Patients who have had treatment of urinary symptoms with botulinum toxin therapy or sacral neuromodulation in the past 6 months\n6. History of a prior implantable tibial neuromodulation system\n7. Patients who are pregnant or planning to become pregnant during the course of the study\n8. Patient is currently enrolled or plans to enroll in concurrent drug/device study that may confound study results","sex":"ALL","minimumAge":"18 Years","healthyVolunteers":false},"eh":"53448700695e227d","sponsor":"MedtronicNeuro","collaborators":[],"officials":[],"central":[{"name":"Mylene Champs","role":"CONTACT","phone":"763-526-1627","email":"mylene.champs@medtronic.com"}],"sites":[],"siteContacts":{"Urology Centers of Alabama|Homewood|35209":{"contacts":[{"name":"Kaitlin Williams","role":"CONTACT","phone":"205-930-0920"},{"name":"Alison Pickering","role":"PRINCIPAL_INVESTIGATOR"}]},"Academic Urology & Urogynecology of Arizona|Glendale|85306":{"contacts":[{"name":"Maria Jimenez","role":"CONTACT","phone":"623-547-2600"},{"name":"Jennifer Klauschie","role":"PRINCIPAL_INVESTIGATOR"}]},"Rosemark Women Care Specialists|Idaho Falls|83404":{"contacts":[{"name":"Liz Carranza","role":"CONTACT","phone":"208-557-2900"},{"name":"Ty Erickson","role":"PRINCIPAL_INVESTIGATOR"}]},"Chesapeake Urology Research Associates|Owings Mills|21117":{"contacts":[{"name":"Seema Shahi","role":"CONTACT","phone":"410-581-1600"},{"name":"Laura Giusto","role":"PRINCIPAL_INVESTIGATOR"}]},"Urology of Saint Louis|St Louis|63141":{"contacts":[{"name":"Jackie King","role":"CONTACT","phone":"314-567-6071"},{"name":"Travis Bullock","role":"PRINC