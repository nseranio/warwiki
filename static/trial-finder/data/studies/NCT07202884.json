{"schema":1,"id":"NCT07202884","briefTitle":"A Study of Orforglipron in Female Participants With Stress Urinary Incontinence Who Have Obesity or Overweight","officialTitle":"A Master Protocol to Investigate the Efficacy and Safety of Orforglipron Tablet Once Daily Compared With Placebo in Female Participants With Stress Urinary Incontinence Who Have Obesity or Overweight","acronym":"RESTRAIN-SUI","ids":["27672","2025-522514-23-00","J2A-MC-GZPS","J2A-MC-GZS1","J2A-MC-GZS2"],"status":{"overall":"RECRUITING","verified":"2026-11","lastUpdatePosted":{"d":"2026-11-04","t":"ACTUAL"},"firstPosted":{"d":"2025-10-02","t":"ACTUAL"},"start":{"d":"2025-09-30","t":"ACTUAL"},"primaryCompletion":{"d":"2028-03","t":"ESTIMATED"},"completion":{"d":"2028-03","t":"ESTIMATED"}},"design":{"type":"INTERVENTIONAL","phases":["PHASE3"],"allocation":"RANDOMIZED","model":"PARALLEL","purpose":"TREATMENT","masking":"DOUBLE","enrollment":{"count":1000,"type":"ESTIMATED"}},"conditions":["Urinary Incontinence,Stress"],"arms":[{"label":"Orforglipron (GZS1)","type":"EXPERIMENTAL","description":"Participants will receive orforglipron orally","interventions":["Drug: Orforglipron"]},{"label":"Placebo (GZS1)","type":"PLACEBO_COMPARATOR","description":"Participants will receive placebo orally","interventions":["Drug: Placebo"]},{"label":"Orforglipron (GZS2)","type":"EXPERIMENTAL","description":"Participants will receive orforglipron orally","interventions":["Drug: Orforglipron"]},{"label":"Placebo (GZS2)","type":"PLACEBO_COMPARATOR","description":"Participants will receive placebo orally","interventions":["Drug: Placebo"]}],"interventions":[{"type":"DRUG","name":"Orforglipron","otherNames":["LY3502970"]},{"type":"DRUG","name":"Placebo","otherNames":[]}],"eligibility":{"text":"Inclusion Criteria:\n\n* Have a body mass index (BMI) of 27 kilograms per square meter (kg/m2) or higher at screening\n* Have a diagnosis of stress urinary incontinence\n\nExclusion Criteria:\n\n* Have had urinary incontinence surgery